+/* Sub-opcodes carried in src2u.x by the NVAPI HLSL header. The header documents
+ * them as immediate constants. */
+enum
+{
+	NVAPI_ATOM_ADD = 3,
+	NVAPI_ATOM_MAX = 6,
+	NVAPI_ATOM_MIN = 7,
+};
+
+static bool nvapi_atomic_float_opcode(Converter::Impl &impl, uint32_t sub_op, spv::Op *out)
+{
+	switch (sub_op)
+	{
+	case NVAPI_ATOM_ADD: *out = spv::OpAtomicFAddEXT; return true;
+	case NVAPI_ATOM_MAX: *out = spv::OpAtomicFMaxEXT; return true;
+	case NVAPI_ATOM_MIN: *out = spv::OpAtomicFMinEXT; return true;
+	default:
+		LOGE("NVAPI float atomic sub-opcode %u is not supported.\n", sub_op);
+		(void)impl;
+		return false;
+	}
+}
+
+/* Turns a RWByteAddressBuffer byte address into an element index for an alias
+ * whose elements are element_size bytes wide. */
+static spv::Id nvapi_byte_address_to_index(Converter::Impl &impl, spv::Id byte_addr, uint32_t element_size_log2)
+{
+	auto &builder = impl.builder();
+	auto *shift = impl.allocate(spv::OpShiftRightLogical, builder.makeUintType(32));
+	shift->add_id(byte_addr);
+	shift->add_id(builder.makeUintConstant(element_size_log2));
+	impl.add(shift);
+	return shift->id;
+}
