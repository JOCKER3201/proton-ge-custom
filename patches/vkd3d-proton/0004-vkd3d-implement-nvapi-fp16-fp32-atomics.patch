+/* __NvAtomicAddFP32 and friends. Same shape as FP16x2, but a scalar fp32. */
+static bool emit_nvapi_extn_op_fp32_atomic(Converter::Impl &impl)
+{
+	if (!impl.nvapi.marked_uav)
+		return false;
+
+	auto &builder = impl.builder();
+
+	auto *sub_op_value = llvm::dyn_cast<llvm::ConstantInt>(impl.nvapi.fake_doorbell_inputs[NVAPI_ARGUMENT_SRC2U + 0]);
+	if (!sub_op_value)
 	{
-		auto *ptr = impl.allocate(spv::OpImageWrite);
-		ptr->add_id(id);
-		ptr->add_id(addr);
-		ptr->add_id(impl.build_splat_constant_vector(builder.makeFloatType(32), builder.makeFloatConstant(2.0f), 4));
-		impl.add(ptr);
-
-		builder.addCapability(spv::CapabilityStorageImageWriteWithoutFormat);
-		impl.nvapi.fake_doorbell_outputs[NVAPI_ARGUMENT_DST0U + 0] = builder.makeUintConstant(42);
+		LOGE("NVAPI FP32 atomic sub-opcode is not a constant, cannot translate.\n");
+		return false;
 	}
 
+	uint32_t sub_op = uint32_t(sub_op_value->getUniqueInteger().getZExtValue());
+	spv::Op atomic_opcode;
+	if (!nvapi_atomic_float_opcode(impl, sub_op, &atomic_opcode))
+		return false;
+
+	spv::Id id = impl.get_id_for_value(impl.nvapi.marked_uav);
+	const auto &meta = impl.handle_to_resource_meta[id];
+
+	bool is_buffer = meta.storage == spv::StorageClassStorageBuffer;
+
+	if (sub_op == NVAPI_ATOM_ADD)
+	{
+		builder.addExtension("SPV_EXT_shader_atomic_float_add");
+		builder.addCapability(spv::CapabilityAtomicFloat32AddEXT);
+	}
+	else
+	{
+		builder.addExtension("SPV_EXT_shader_atomic_float_min_max");
+		builder.addCapability(spv::CapabilityAtomicFloat32MinMaxEXT);
+	}
+
+	spv::Id float_type = builder.makeFloatType(32);
+	dxil_spv::Operation *chain;
+
+	if (is_buffer)
+	{
+		/* Each fp32 element is 4 bytes wide. */
+		spv::Id index = nvapi_byte_address_to_index(impl, get_argument(impl, NVAPI_ARGUMENT_SRC0U + 0), 2);
+		spv::Id ssbo_id = get_buffer_alias_handle(impl, meta, id, RawType::Float, RawWidth::B32, RawVecSize::V1);
+
+		chain = impl.allocate(spv::OpAccessChain, builder.makePointer(spv::StorageClassStorageBuffer, float_type));
+		chain->add_ids({ ssbo_id, builder.makeUintConstant(0), index });
+	}
+	else
+	{
+		/* Typed UAV. The image already has a 32-bit float sampled type, so the
+		 * texel pointer needs no aliased redeclaration. */
+		uint32_t num_coords_full = 0, num_coords = 0;
+		if (!get_image_dimensions(impl, id, &num_coords_full, &num_coords))
+			return false;
+		if (num_coords_full > 3)
+		{
+			LOGE("NVAPI FP32 atomic on %u-dimensional UAV is not supported.\n", num_coords_full);
+			return false;
+		}
+
+		spv::Id coords[3] = {};
+		for (uint32_t i = 0; i < num_coords_full; i++)
+			coords[i] = get_argument(impl, NVAPI_ARGUMENT_SRC0U + i);
+		spv::Id coord = impl.build_vector(builder.makeUintType(32), coords, num_coords_full);
+
+		chain = impl.allocate(spv::OpImageTexelPointer, builder.makePointer(spv::StorageClassImage, float_type));
+		chain->add_ids({ meta.var_id, coord, builder.makeUintConstant(0) });
+	}
+	impl.add(chain);
+
+	auto *value = impl.allocate(spv::OpBitcast, float_type);
+	value->add_id(get_argument(impl, NVAPI_ARGUMENT_SRC1U + 0));
+	impl.add(value);
+
+	auto *atomic = impl.allocate(atomic_opcode, float_type);
+	atomic->add_id(chain->id);
+	atomic->add_id(builder.getAtomicDeviceScopeId());
+	atomic->add_id(builder.makeUintConstant(0));
+	atomic->add_id(value->id);
