 	bool raw_access_16bit = false;
 	bool raw_access_64bit = false;
 
+	aliased_access.needs_fp16_vector_image_alias = tracking.needs_fp16_vector_image_alias;
+
 	for (int type_ = 0; type_ < int(RawType::Count); type_++)
 	{
 		for (int width_ = 0; width_ < int(RawWidth::Count); width_++)
 		{
 			auto width = RawWidth(width_);
-			if (width == RawWidth::B16 && !execution_mode_meta.native_16bit_operations)
+			/* A forced 16-bit alias only makes sense for buffer-backed
+			 * descriptors; typed images carry their own element type. */
+			bool buffer_backed = descriptor_type == VulkanDescriptorType::SSBO ||
+			                     descriptor_type == VulkanDescriptorType::UBO ||
+			                     descriptor_type == VulkanDescriptorType::BufferDeviceAddress;
+			bool forced_16bit = tracking.force_raw_16bit_alias && buffer_backed;
+			if (width == RawWidth::B16 && !execution_mode_meta.native_16bit_operations && !forced_16bit)
 				continue;
 
 			for (int vecsize_ = 0; vecsize_ < int(RawVecSize::Count); vecsize_++)
 			{
 				auto vecsize = RawVecSize(vecsize_);
 				auto type = RawType(type_);
+
+				/* The fp16x2 vendor intrinsic requests this declaration up front,
+				 * before the descriptor type is known. On a typed image it is
+				 * meaningless and would trip the raw-16-bit guard below. */
+				if (tracking.force_raw_16bit_alias && !buffer_backed &&
+				    type == RawType::Float && width == RawWidth::B16 && vecsize == RawVecSize::V2)
+					continue;
 				// Non-native 16-bit SSBOs are declared as 32-bit, so avoid false aliases.
 				bool has_decl = tracking.raw_access_buffer_declarations[type_][width_][vecsize_];
 				if (!has_decl && RawWidth(width) == RawWidth::B32 && !execution_mode_meta.native_16bit_operations)
@@ -2167,6 +2183,17 @@ bool Converter::Impl::emit_uavs(const llvm::MDNode *uavs, const llvm::MDNode *re
 				ref.var_id = create_bindless_heap_variable(bindless_info);
 			}
 
+			if (aliased_access.needs_fp16_vector_image_alias &&
+			    vulkan_binding.buffer_binding.descriptor_type != VulkanDescriptorType::SSBO &&
+			    vulkan_binding.buffer_binding.descriptor_type != VulkanDescriptorType::BufferDeviceAddress)
+			{
+				auto fp16_info = bindless_info;
+				fp16_info.component = DXIL::ComponentType::F16;
+				fp16_info.raw_vecsize = RawVecSize::V2;
+				fp16_info.format = spv::ImageFormatRg16f;
+				ref.fp16_vector_var_id = create_bindless_heap_variable(fp16_info);
+			}
+
 			ref.aliased = aliased_access.requires_alias_decoration;
 			ref.push_constant_member = vulkan_binding.buffer_binding.root_constant_index + root_descriptor_count;
 			ref.base_offset = heap_offset;
@@ -2263,8 +2290,34 @@ bool Converter::Impl::emit_uavs(const llvm::MDNode *uavs, const llvm::MDNode *re
 					builder.addDecoration(var_id, spv::DecorationRelaxedPrecision);
 			}
 
+			/* NVAPI fp16x2 atomics address the image through a half-typed view
+			 * of the very same descriptor. */
+			spv::Id fp16_vector_var_id = 0;
+			if (aliased_access.needs_fp16_vector_image_alias && storage == spv::StorageClassUniformConstant)
+			{
+				/* The fp16x2 image atomics are defined against rg16f/rgba16f
+				 * format qualifiers by NV_shader_atomic_fp16_vector; the SPIR-V
+				 * extension itself only relaxes the atomic result type. */
+				spv::Id alias_type_id = builder.makeImageType(
+				    builder.makeFloatType(16), image_dimension_from_resource_kind(resource_kind), false,
+				    image_dimension_is_arrayed(resource_kind),
+				    image_dimension_is_multisampled(resource_kind), 2, spv::ImageFormatRg16f);
+
+				if (range_size != 1)
+				{
+					if (range_size == ~0u)
+						alias_type_id = builder.makeRuntimeArray(alias_type_id);
+					else
+						alias_type_id = builder.makeArrayType(alias_type_id, builder.makeUintConstant(range_size), 0);
+				}
+
+				fp16_vector_var_id = create_variable(storage, alias_type_id,
+				                                     name.empty() ? nullptr : (name + "Fp16").c_str());
+			}
+
 			auto &ref = uav_index_to_reference[index];
 			ref.var_id = var_id;
+			ref.fp16_vector_var_id = fp16_vector_var_id;
 			ref.var_alias_group = std::move(var_alias_group);
 			ref.aliased = aliased_access.requires_alias_decoration;
 			ref.stride = stride;
@@ -2293,6 +2346,8 @@ bool Converter::Impl::emit_uavs(const llvm::MDNode *uavs, const llvm::MDNode *re
 
 			if (var_id)
 				decorate_variable(var_id);
+			if (fp16_vector_var_id)
+				decorate_variable(fp16_vector_var_id);
 			for (auto &var : ref.var_alias_group)
 				decorate_variable(var.var_id);
 
