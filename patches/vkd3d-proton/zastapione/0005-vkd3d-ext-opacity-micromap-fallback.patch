+/* Deliberately not folded into vkd3d_acceleration_structure_write_postbuild_info, which is shared
+ * with the acceleration structure path. */
+static void vkd3d_opacity_micromap_write_postbuild_info_ext(
+        struct d3d12_command_list *list,
+        const D3D12_RAYTRACING_ACCELERATION_STRUCTURE_POSTBUILD_INFO_DESC *desc,
+        VkMicromapEXT vk_micromap)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+    const struct vkd3d_unique_resource *resource;
+    const VkDeviceSize stride = sizeof(uint64_t);
+    VkQueryPool vk_query_pool;
+    VkQueryType vk_query_type;
+    uint32_t vk_query_index;
+    uint32_t type_index;
+    VkBuffer vk_buffer;
+    uint32_t offset;
+
+    resource = vkd3d_va_map_deref(&list->device->memory_allocator.va_map, desc->DestBuffer);
+    if (!resource)
+    {
+        ERR("Invalid resource.\n");
+        return;
+    }
+
+    vk_buffer = resource->vk_buffer;
+    offset = desc->DestBuffer - resource->va;
+
+    if (desc->InfoType == D3D12_RAYTRACING_ACCELERATION_STRUCTURE_POSTBUILD_INFO_COMPACTED_SIZE)
+    {
+        vk_query_type = VK_QUERY_TYPE_MICROMAP_COMPACTED_SIZE_EXT;
+        type_index = VKD3D_QUERY_TYPE_INDEX_OMM_COMPACTED_SIZE;
+    }
+    else if (desc->InfoType == D3D12_RAYTRACING_ACCELERATION_STRUCTURE_POSTBUILD_INFO_SERIALIZATION)
+    {
+        /* VK_QUERY_TYPE_MICROMAP_SERIALIZATION_SIZE_EXT would answer this truthfully, but
+         * vkd3d_opacity_micromap_copy_ext cannot execute the SERIALIZE copy the application would
+         * issue next, so handing out a plausible size only buys a buffer full of garbage.
+         * FIXME: implement micromap serialization, then restore the real query here.
+         * Both halves are missing: vkCmdCopyMicromapToMemoryEXT / vkCmdCopyMemoryToMicromapEXT are
+         * not loaded (vulkan_procs.h), and DESERIALIZE cannot even be routed to the micromap path,
+         * because its source is plain memory and nothing at record time distinguishes a serialized
+         * micromap from a serialized acceleration structure. */
+        FIXME_ONCE("Opacity micromap serialization is not implemented on the VK_EXT_opacity_micromap "
+                "fallback, reporting SerializedSizeInBytes = 0.\n");
+        VK_CALL(vkCmdFillBuffer(list->cmd.vk_command_buffer, vk_buffer, offset,
+                2 * sizeof(uint64_t), 0));
+        return;
+    }
+    else
+    {
+        /* VK_EXT_opacity_micromap has no equivalent of VK_QUERY_TYPE_ACCELERATION_STRUCTURE_SIZE_KHR,
+         * so CURRENT_SIZE is a known gap of this fallback. */
+        FIXME_ONCE("Unsupported InfoType %u on the VK_EXT_opacity_micromap fallback.\n", desc->InfoType);
+        VK_CALL(vkCmdFillBuffer(list->cmd.vk_command_buffer, vk_buffer, offset,
+                sizeof(uint64_t), 0));
+        return;
+    }
+
+    if (!d3d12_command_allocator_allocate_query_from_type_index(list->allocator,
+            type_index, &vk_query_pool, &vk_query_index))
+    {
+        ERR("Failed to allocate query.\n");
+        return;
+    }
+
+    VK_CALL(vkCmdWriteMicromapsPropertiesEXT(list->cmd.vk_command_buffer,
+            1, &vk_micromap, vk_query_type, vk_query_pool, vk_query_index));
+    VK_CALL(vkCmdCopyQueryPoolResults(list->cmd.vk_command_buffer,
+            vk_query_pool, vk_query_index, 1,
+            vk_buffer, offset, stride,
+            VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WAIT_BIT));
+}
+
+void vkd3d_opacity_micromap_emit_immediate_postbuild_info_ext(
+        struct d3d12_command_list *list, uint32_t count,
+        const D3D12_RAYTRACING_ACCELERATION_STRUCTURE_POSTBUILD_INFO_DESC *desc,
+        VkDeviceAddress va,
+        VkMicromapEXT vk_opacity_micromap)
+{
+    /* In D3D12 we are supposed to be able to emit without an explicit barrier,
+     * but we need to emit them for Vulkan. */
+
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+    VkDependencyInfo dep_info;
+    VkMemoryBarrier2 barrier;
+    uint32_t i;
+
+    RT_TRACE("Emitting immediate postbuild info for micromap at VA %"PRIx64".\n", va);
+
+    /* Micromap writes are only ever visible through the MICROMAP access bits, and
+     * VK_ACCESS_2_MICROMAP_WRITE_BIT_EXT is only valid in MICROMAP_BUILD stage. */
+    memset(&barrier, 0, sizeof(barrier));
+    barrier.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER_2;
+    barrier.srcStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+    barrier.srcAccessMask = VK_ACCESS_2_MICROMAP_WRITE_BIT_EXT;
+    barrier.dstStageMask = VK_PIPELINE_STAGE_2_MICROMAP_BUILD_BIT_EXT | VK_PIPELINE_STAGE_2_COPY_BIT;
+    barrier.dstAccessMask = VK_ACCESS_2_MICROMAP_READ_BIT_EXT | VK_ACCESS_2_TRANSFER_WRITE_BIT;
+
+    memset(&dep_info, 0, sizeof(dep_info));
+    dep_info.sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO;
+    dep_info.memoryBarrierCount = 1;
+    dep_info.pMemoryBarriers = &barrier;
+
+    VK_CALL(vkCmdPipelineBarrier2(list->cmd.vk_command_buffer, &dep_info));
+
+    for (i = 0; i < count; i++)
+        vkd3d_opacity_micromap_write_postbuild_info_ext(list, &desc[i], vk_opacity_micromap);
+
+    vkd3d_opacity_micromap_end_barrier(list);
+}
