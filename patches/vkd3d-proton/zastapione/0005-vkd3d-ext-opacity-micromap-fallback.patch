+        VkCopyMicromapModeEXT *vk_mode)
+{
+    /* VkCopyMicromapModeEXT and VkCopyAccelerationStructureModeKHR use different numeric values for
+     * COMPACT and SERIALIZE, so this cannot share the acceleration structure converter. */
+    switch (mode)
+    {
+        case D3D12_RAYTRACING_ACCELERATION_STRUCTURE_COPY_MODE_CLONE:
+            *vk_mode = VK_COPY_MICROMAP_MODE_CLONE_EXT;
+            return true;
+        case D3D12_RAYTRACING_ACCELERATION_STRUCTURE_COPY_MODE_COMPACT:
+            *vk_mode = VK_COPY_MICROMAP_MODE_COMPACT_EXT;
+            return true;
+        default:
+            /* SERIALIZE / DESERIALIZE. Nothing is recorded, so the destination keeps whatever it
+             * had; this is the same gap that makes the SERIALIZATION postbuild query report zero in
+             * vkd3d_opacity_micromap_write_postbuild_info_ext. Kept loud on purpose.
