+/* The list is push only, so an application rebuilding the array at the same VA with a genuinely
+ * different histogram would grow it without bound for the lifetime of the allocation. Past this
+ * many revisions we stop tracking the VA and fall back to the upstream EXT behaviour,
+ * usageCountsCount = 0, which the lookup already implements for count == 0. A build which
+ * legitimately publishes an empty histogram degrades the VA in the same way; that is the same legal
+ * fallback, not a new failure mode. */
+#define VKD3D_OMM_USAGE_HISTOGRAM_MAX_NODES_EXT 256u
+
+/* Takes ownership of node, which must be fully populated; it is published as is or freed. */
+static void vkd3d_opacity_micromap_publish_usage_histogram_node_ext(struct vkd3d_view *view,
+        struct vkd3d_omm_usage_histogram_ext *node)
+{
+    const struct vkd3d_omm_usage_histogram_ext *iter;
+    struct vkd3d_omm_usage_histogram_ext *previous;
+    struct vkd3d_omm_usage_histogram_ext *head;
+    size_t usages_size;
+    unsigned int depth;
+
+    usages_size = node->count * sizeof(*node->usages);
+
+    head = vkd3d_atomic_ptr_load_explicit(&view->info.buffer.omm_histogram_ext, vkd3d_memory_order_acquire);
+
+    for (;;)
+    {
+        /* Rebuilding the same OMM array every frame is the dominant case; deduplicating against the
+         * current head keeps that from leaking a node per build. Nodes are immutable, so this needs
+         * no lock. */
+        if (head && head->count == node->count && !memcmp(head->usages, node->usages, usages_size))
+        {
+            vkd3d_free(node);
+            return;
+        }
+
+        /* Already degraded to count = 0. Nothing left to publish, and pushing again would restart
+         * the growth this cap exists to stop. */
+        if (head && !head->count)
+        {
+            vkd3d_free(node);
+            return;
+        }
+
+        for (depth = 0, iter = head; iter; iter = iter->next)
+            depth++;
+
+        if (depth >= VKD3D_OMM_USAGE_HISTOGRAM_MAX_NODES_EXT)
+        {
+            /* Must fall through to the push below. Restarting the loop here would re-run this same
+             * test against an unchanged head and spin forever. */
+            WARN("OMM array view %p exceeded %u usage histogram revisions, falling back to "
+                    "usageCountsCount = 0 for this VA.\n", view, VKD3D_OMM_USAGE_HISTOGRAM_MAX_NODES_EXT);
+            node->count = 0;
+            usages_size = 0;
+        }
+
+        node->next = head;
+        previous = vkd3d_atomic_ptr_compare_exchange(&view->info.buffer.omm_histogram_ext, head, node,
+                vkd3d_memory_order_release, vkd3d_memory_order_acquire);
+        if (previous == head)
+            break;
+        head = previous;
+    }
+
+    if (head)
+    {
+        /* The old node stays linked forever on purpose. A command list recorded earlier may already
+         * point pUsageCounts at it, and it is only unreachable once the allocation dies. */
+        WARN("OMM array rebuilt with a different usage histogram, %u entries replacing %u.\n",
+                node->count, head->count);
+    }
+}
+
+void vkd3d_opacity_micromap_publish_usage_histogram_ext(struct vkd3d_view *view,
+        const D3D12_RAYTRACING_OPACITY_MICROMAP_ARRAY_DESC *desc)
+{
+    struct vkd3d_omm_usage_histogram_ext *node;
+
+    if (!(node = vkd3d_malloc(sizeof(*node) + desc->NumOmmHistogramEntries * sizeof(*node->usages))))
+    {
+        ERR("Failed to allocate OMM usage histogram.\n");
+        return;
+    }
+
+    /* Reuses the exact conversion the build itself uses, so the linkage cannot disagree with the
+     * array it points at. */
+    node->next = NULL;
+    node->count = vkd3d_opacity_micromap_convert_inputs_usages_ext(desc, node->usages);
+
+    vkd3d_opacity_micromap_publish_usage_histogram_node_ext(view, node);
