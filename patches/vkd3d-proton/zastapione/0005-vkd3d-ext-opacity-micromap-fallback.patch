+static void vkd3d_opacity_micromap_inherit_usage_histogram_ext(struct vkd3d_view *dst_view,
+        const struct vkd3d_view *src_view)
+{
+    const struct vkd3d_omm_usage_histogram_ext *src_node;
+    struct vkd3d_omm_usage_histogram_ext *node;
+    size_t usages_size;
+
+    src_node = vkd3d_atomic_ptr_load_explicit(&src_view->info.buffer.omm_histogram_ext,
+            vkd3d_memory_order_acquire);
+    if (!src_node)
+        return;
+
+    usages_size = src_node->count * sizeof(*src_node->usages);
+
+    if (!(node = vkd3d_malloc(sizeof(*node) + usages_size)))
+    {
+        ERR("Failed to allocate OMM usage histogram.\n");
+        return;
+    }
+
+    node->next = NULL;
+    node->count = src_node->count;
+    memcpy(node->usages, src_node->usages, usages_size);
+
+    vkd3d_opacity_micromap_publish_usage_histogram_node_ext(dst_view, node);
+}
+
+uint32_t vkd3d_opacity_micromap_lookup_usage_histogram_ext(struct d3d12_device *device,
+        D3D12_GPU_VIRTUAL_ADDRESS va, const VkMicromapUsageEXT **usages)
+{
+    const struct vkd3d_omm_usage_histogram_ext *node;
+    const struct vkd3d_view *view;
+
+    *usages = NULL;
+
+    /* Default behaviour is usageCountsCount = 0, exactly like the upstream EXT backend. The
+     * republication below cannot be enabled by default because it is not stable in time: the
+     * histogram node only appears when the OMM array build is recorded, so a prebuild sizing query
+     * issued before that build sees 0 while the build itself would see N, and
+     * vkCmdBuildAccelerationStructuresKHR requires the build info to match the one the sizes were
+     * queried with. */
+    if (!VKD3D_CONFIG_FLAG_IS_SET(OMM_EXT_LINKAGE_USAGE_COUNTS))
+        return 0;
+
+    /* The geometry does not reference an OMM array at all. Zero is the complete answer here, not a
+     * fallback; the KHR linkage struct cannot express anything else either. */
+    if (!va)
+        return 0;
+
+    /* try_read never creates a view, but that only makes the read itself side effect free; it does
+     * not make two reads of the same VA agree over time. See the flag comment above. */
+    view = vkd3d_va_map_try_read_opacity_micromap_view_ext(&device->memory_allocator.va_map, device, va);
+    node = view ? vkd3d_atomic_ptr_load_explicit(&view->info.buffer.omm_histogram_ext,
+            vkd3d_memory_order_acquire) : NULL;
+
+    if (!node)
+    {
+        /* Reachable when the array at this VA has not been built on this device yet, when it
+         * appeared through DESERIALIZE (unimplemented on this backend), or when the BLAS is recorded
+         * in parallel with the array build in another command list. Falls back to what the upstream
+         * EXT backend did for three years: usageCountsCount = 0. Legal per
+         * VUID-VkAccelerationStructureTrianglesOpacityMicromapEXT-pUsageCounts-07335, and still
+         * strictly more information than the KHR linkage struct is able to carry. Loud, not silent. */
+        FIXME_ONCE("No OMM usage histogram recorded for VA #%"PRIx64". Sending usageCountsCount = 0 "
+                "(upstream EXT behaviour). BLAS will be sized without micromap usage information.\n", va);
+        return 0;
+    }
+
+    if (!node->count)
+        return 0;
+
+    *usages = node->usages;
+    return node->count;
+}
