diff --git a/libs/vkd3d/command.c b/libs/vkd3d/command.c
--- a/libs/vkd3d/command.c
+++ b/libs/vkd3d/command.c
@@ -6461,6 +6461,14 @@ static void vk_access_and_stage_flags_from_d3d12_resource_state(const struct d3d
                     *stages |= VK_PIPELINE_STAGE_2_ACCELERATION_STRUCTURE_BUILD_BIT_KHR;
                     *access |= VK_ACCESS_2_ACCELERATION_STRUCTURE_READ_BIT_KHR |
                             VK_ACCESS_2_ACCELERATION_STRUCTURE_WRITE_BIT_KHR;
+
+                    /* VkMicromapEXT accesses are not covered by the acceleration structure bits. */
+                    if (d3d12_device_uses_ext_opacity_micromap(device))
+                    {
+                        *stages |= VK_PIPELINE_STAGE_2_MICROMAP_BUILD_BIT_EXT;
+                        *access |= VK_ACCESS_2_MICROMAP_READ_BIT_EXT |
+                                VK_ACCESS_2_MICROMAP_WRITE_BIT_EXT;
+                    }
                 }
                 break;
 
@@ -6472,6 +6480,14 @@ static void vk_access_and_stage_flags_from_d3d12_resource_state(const struct d3d
                             VK_PIPELINE_STAGE_2_RAY_TRACING_SHADER_BIT_KHR;
                     *access |= VK_ACCESS_2_ACCELERATION_STRUCTURE_WRITE_BIT_KHR |
                             VK_ACCESS_2_ACCELERATION_STRUCTURE_READ_BIT_KHR;
+
+                    /* OMM arrays live in this state too, and on EXT they are their own object type. */
+                    if (d3d12_device_uses_ext_opacity_micromap(device))
+                    {
+                        *stages |= VK_PIPELINE_STAGE_2_MICROMAP_BUILD_BIT_EXT;
+                        *access |= VK_ACCESS_2_MICROMAP_READ_BIT_EXT |
+                                VK_ACCESS_2_MICROMAP_WRITE_BIT_EXT;
+                    }
                 }
                 break;
 
@@ -6498,6 +6514,10 @@ static void vk_access_and_stage_flags_from_d3d12_resource_state(const struct d3d
                     /* Vertex / index / transform buffer inputs are NON_PIXEL_SHADER_RESOURCES in DXR.
                      * They access SHADER_READ_BIT in Vulkan, so just need to add the stage. */
                     *stages |= VK_PIPELINE_STAGE_2_ACCELERATION_STRUCTURE_BUILD_BIT_KHR;
+
+                    /* Same reasoning for the OMM input and per-OMM descriptor buffers. */
+                    if (d3d12_device_uses_ext_opacity_micromap(device))
+                        *stages |= VK_PIPELINE_STAGE_2_MICROMAP_BUILD_BIT_EXT;
                 }
                 break;
 
@@ -21195,11 +21215,11 @@ static void d3d12_command_list_free_rtas_batch(struct d3d12_command_list *list)
 
     vkd3d_free(rtas_batch->build_infos);
     vkd3d_free(rtas_batch->geometry_infos);
-    vkd3d_free(rtas_batch->omm_triangles_infos);
+    vkd3d_free(rtas_batch->omm_triangles_infos.khr);
     vkd3d_free(rtas_batch->range_infos);
     vkd3d_free(rtas_batch->range_ptrs);
-    vkd3d_free(rtas_batch->omm_build_infos);
-    vkd3d_free(rtas_batch->omm_usage_infos);
+    vkd3d_free(rtas_batch->omm_build_infos.khr);
+    vkd3d_free(rtas_batch->omm_usage_infos.khr);
     vkd3d_free(rtas_batch->scratch_usage);
     vkd3d_free(rtas_batch->postbuild_infos);
 }
@@ -21215,7 +21235,9 @@ static bool d3d12_command_list_register_rtas_scratch_range(
     {
         if (max(rtas_batch->scratch_usage[i].va_start, scratch) < min(rtas_batch->scratch_usage[i].va_end, scratch_end))
         {
-            /* The last element is already allocated and we cannot submit that quite yet. */
+            /* The last element is already allocated and we cannot submit that quite yet.
+             * Only ever reached from the BLAS/TLAS path, so build_info_count is the right counter;
+             * OMM array builds deliberately do not register their scratch range. */
             list->rtas_batch.build_info_count--;
 
             WARN("Application bug detected. Attempting to use scratch which is currently in flight on GPU. Flushing batch.\n");
@@ -21235,10 +21257,11 @@ static bool d3d12_command_list_register_rtas_scratch_range(
 static bool d3d12_command_list_allocate_rtas_build_info(struct d3d12_command_list *list, uint32_t geometry_count,
         VkAccelerationStructureBuildGeometryInfoKHR **build_info,
         VkAccelerationStructureGeometryKHR **geometry_infos,
-        VkAccelerationStructureTrianglesOpacityMicromapKHR **omm_triangles_infos,
+        union vkd3d_omm_triangles_info *omm_triangles_infos,
         VkAccelerationStructureBuildRangeInfoKHR **range_infos)
 {
     struct d3d12_rtas_batch_state *rtas_batch = &list->rtas_batch;
+    bool uses_ext_omm = d3d12_device_uses_ext_opacity_micromap(list->device);
 
     if (!vkd3d_array_reserve((void **)&rtas_batch->build_infos, &rtas_batch->build_info_size,
             rtas_batch->build_info_count + 1, sizeof(*rtas_batch->build_infos)))
@@ -21256,8 +21279,11 @@ static bool d3d12_command_list_allocate_rtas_build_info(struct d3d12_command_lis
 
     if (list->device->device_info.supports_opacity_micromap)
     {
-        if (!vkd3d_array_reserve((void **)&rtas_batch->omm_triangles_infos, &rtas_batch->omm_triangles_info_size,
-                rtas_batch->geometry_info_count + geometry_count, sizeof(*rtas_batch->omm_triangles_infos)))
+        /* The two backends disagree on the element size, so the reserve has to know which one is in use. */
+        if (!vkd3d_array_reserve((void **)&rtas_batch->omm_triangles_infos.khr, &rtas_batch->omm_triangles_info_size,
+                rtas_batch->geometry_info_count + geometry_count,
+                uses_ext_omm ? sizeof(*rtas_batch->omm_triangles_infos.ext) :
+                        sizeof(*rtas_batch->omm_triangles_infos.khr)))
         {
             ERR("Failed to allocate opacity micromap info array.\n");
             return false;
@@ -21273,10 +21299,12 @@ static bool d3d12_command_list_allocate_rtas_build_info(struct d3d12_command_lis
 
